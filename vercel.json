{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/log",
      "destination": "/api/log.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
